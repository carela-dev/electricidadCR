# ============================================================
#  LY-C100A Energy Dashboard - variables de entorno
#  Copia este archivo a `.env` (raíz del repo) y rellena.
# ============================================================

# --- Servidor HTTP ---
PORT=4000
# Origen permitido para CORS (frontend en desarrollo). Vacío = permitir todo.
CORS_ORIGIN=http://localhost:5173

# --- Fuente de datos: Tuya Cloud API (IoT Core) ---
# Región del proyecto cloud: eu | us | cn | in
TUYA_REGION=eu
# Access ID / Access Secret del proyecto cloud (iot.tuya.com -> Cloud -> tu proyecto)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# ID del dispositivo (LY-C100A) - visible en iot.tuya.com -> Dispositivos
TUYA_DEVICE_ID=

# Intervalo de sondeo (ms). El plan básico tiene límites de tasa: usa >= 10 000.
TUYA_POLL_INTERVAL_MS=10000

# Escala del contador de energía. Normalmente `add_ele` ya viene en kWh (escala 1).
# Si tu medidor reporta Wh, usa 0.001.
TUYA_ENERGY_SCALE=1

# --- Modo DEMO (sin hardware / para probar la UI) ---
# TUYA_DEMO=1 genera datos sintéticos de 2 fases (L1/L2) en tiempo real.
#TUYA_DEMO=1

# --- Almacenamiento local del historial ---
#DATA_DIR=./data
#HISTORY_RETENTION_DAYS=7

# --- Sync opcional a Supabase (espejo del historial en tu base) ---
#SYNC_SUPABASE_URL=https://xxxx.supabase.co
#SYNC_SUPABASE_SERVICE_KEY=eyJ...
#SYNC_SUPABASE_TABLE=readings

# --- Sync opcional a Firebase (Firestore) ---
# Cuenta de servicio de Google (Project settings → Service accounts → Generate key).
# El backend acepta: ruta a un archivo JSON, el JSON literal pegado, o el JSON en Base64
# (útil en Render, que no permite montar archivos). firebase-admin ya es dependencia.
#SYNC_FIREBASE_SERVICE_ACCOUNT=/ruta/a/serviceAccountKey.json
#SYNC_FIREBASE_COLLECTION=readings
